generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  DRIVER
}

enum OrderStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COLLECTED
  CANCELLED
  RETURNED
}

enum DeliveryType {
  STANDARD
  EXPRESS
  SAME_DAY
}

// حالة التسوية المالية بين الشركة والتاجر
enum CollectionStatus {
  NOT_COLLECTED      // لم يُحصَّل بعد
  DRIVER_COLLECTED   // السائق استلم الكاش من المستلم
  COMPANY_RECEIVED   // الشركة استلمت من السائق
  SETTLED_TO_MERCHANT // تمت التسوية مع التاجر
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum RefundStatus {
  PENDING
  PROCESSED
  REJECTED
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  password        String
  role            Role     @default(CLIENT)
  isActive        Boolean  @default(true)
  commissionType  String   @default("PERCENTAGE")
  commissionValue Float    @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientOrders   Order[]         @relation("ClientOrders")
  driverOrders   Order[]         @relation("DriverOrders")
  driverEarnings DriverEarning[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  refreshTokens  RefreshToken[]

  @@index([role])
  @@index([isActive])
  @@index([phone])
  @@index([role, isActive])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Zone {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  basePrice   Float        @default(0)
  parentId    String?
  parent      Zone?        @relation("ZoneChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Zone[]       @relation("ZoneChildren")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pricingRule PricingRule?
  orders      Order[]

  @@map("zones")
}

model PricingRule {
  id            String   @id @default(uuid())
  zoneId        String   @unique
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  standardPrice Float    @default(20.0)
  expressPrice  Float    @default(30.0)
  sameDayPrice  Float    @default(50.0)
  driverPayout  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([zoneId])
  @@map("pricing_rules")
}

model Order {
  id                   String           @id @default(uuid())
  shipmentNumber       String           @unique
  clientId             String
  client               User             @relation("ClientOrders", fields: [clientId], references: [id])
  driverId             String?
  driver               User?            @relation("DriverOrders", fields: [driverId], references: [id])
  recipientName        String?
  recipientPhone       String?
  pickupAddress        String
  destination          String
  packageDescription   String?
  deliveryType         DeliveryType     @default(STANDARD)
  status               OrderStatus      @default(PENDING)
  totalPrice           Float
  itemPrice            Float            @default(0)
  deliveryFee          Float            @default(0)
  addonsTotal          Float            @default(0)
  grandTotal           Float            @default(0)
  addons               Json             @default("[]")
  zoneId               String?
  zone                 Zone?            @relation(fields: [zoneId], references: [id])
  notes                String?

  // حالة التسوية المالية
  collectionStatus     CollectionStatus @default(NOT_COLLECTED)

  // أسباب الإلغاء والإرجاع
  cancellationReason   String?
  returnReason         String?
  returnFrom           String?          // من أين أُرجع (مثلاً: من المستلم، من السائق)

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoice       Invoice?
  refund        Refund?
  driverEarning DriverEarning?
  tickets       Ticket[]

  @@index([clientId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([zoneId])
  @@index([shipmentNumber])
  @@index([collectionStatus])
  @@index([deliveryType])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([driverId, createdAt])
  @@map("orders")
}

model Invoice {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pdfUrl      String?
  generatedAt DateTime @default(now())

  @@map("invoices")
}

model Refund {
  id          String       @id @default(uuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@map("refunds")
}

model DriverEarning {
  id              String   @id @default(uuid())
  driverId        String
  driver          User     @relation(fields: [driverId], references: [id])
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  amount          Float
  orderTotal      Float    @default(0)
  companyProfit   Float    @default(0)
  commissionType  String   @default("PERCENTAGE")
  commissionValue Float    @default(15)
  date            DateTime @default(now())

  @@index([driverId])
  @@index([date])
  @@index([driverId, date])
  @@map("driver_earnings")
}

model Ticket {
  id        String       @id @default(uuid())
  clientId  String
  client    User         @relation(fields: [clientId], references: [id])
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages TicketMessage[]

  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@index([updatedAt])
  @@index([clientId, status])
  @@index([status, updatedAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}
